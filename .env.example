# Replace locally with a random URL-safe password (for example, random hex).
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password

# Host IPv4 address for port 8100. Unset/empty defaults to loopback for local use
# and CI. On the server, set its private Tailscale IPv4 address locally only.
# Never use 0.0.0.0 or the LAN address.
APP_BIND_ADDRESS=127.0.0.1

# Absolute host directory paths. Unset/empty uses named volumes: postgres-data,
# sources-empty (read-only in app), and originals-empty (read-write in app).
# Server values: /srv/homelab/med-ask-data/{postgres,sources,originals}.
# Replace each empty value with its absolute path for a server deployment.
POSTGRES_DATA_PATH=
SOURCES_PATH=
ORIGINALS_PATH=

# Optional dashboard-managed tunnel. Leave both empty on local hosts and in CI.
# Only the owner enters the real token on the server; never share or print it.
# To enable after dashboard setup: COMPOSE_PROFILES=tunnel
COMPOSE_PROFILES=
# Placeholder example (do not use): TUNNEL_TOKEN=replace-with-owner-token
TUNNEL_TOKEN=

# Compatible embedding endpoint, reached over the external homelab-models network.
# Purpose aliases only. Dimensions and the reported model are probed at runtime.
MODEL_BASE_URL=http://litellm:4000/v1
MODEL_API_KEY=unused
EMBEDDING_PURPOSE=embed
